# Vite production build configuration. Variables prefixed with VITE_ are
# embedded in the browser bundle and must never contain private secrets.
VITE_API_BASE_URL=https://api.kashpoint.co.za
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# cPanel FTP account. Password-based FTPS on port 21 is the secure default.
CPANEL_FTP_HOST=ftp.kashpoint.co.za
CPANEL_FTP_PORT=21
CPANEL_FTP_USER=replace_with_your_ftp_username
CPANEL_FTP_PASSWORD='replace_with_your_ftp_password'

# Set true only after accepting that ordinary FTP exposes the password and
# uploaded files in transit.
CPANEL_ALLOW_PLAIN_FTP=false

# Build and print the ordered upload list without connecting or uploading.
CPANEL_DRY_RUN=true
