Options -MultiViews
RewriteEngine On

# Serve existing assets normally and send client-side routes to the SPA.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Caching.
#
# Without an explicit Cache-Control the server sends only Last-Modified, and
# browsers fall back to heuristic caching — they invent their own expiry and
# happily serve a stale index.html for hours after a deploy. That points the
# browser at the previous build's asset filenames, so a user keeps running old
# code with no way to tell. It has already caused one "the fix isn't live"
# false alarm.
#
# Order matters below: `Header set` is last-match-wins, so the broad rule comes
# first and the two exceptions override it. Flipping them would quietly mark
# sw.js immutable, since it also ends in .js.
<IfModule mod_headers.c>
  # Everything under /assets/ carries a content hash in its filename, so a
  # changed file is a different URL and the old one can be cached forever.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html is the one file whose name never changes between builds, so it
  # must be revalidated every time or users stay pinned to the previous build.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The service worker decides when users get updates; a stale copy strands
  # them on an old version.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
